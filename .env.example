# ══════════════════════════════════════════════════════════════════════════
# STANDALONE DEV MODE (docker-compose.standalone.yml)
# Use this file as-is for local development with no other stack running.
# ══════════════════════════════════════════════════════════════════════════
ENVIRONMENT=development

DATABASE_URL=postgresql+psycopg://searchos:searchos@postgres:5432/searchos
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1

JWT_SECRET_KEY=change-me-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://ollama:11434
LMSTUDIO_BASE_URL=http://lmstudio:1234

SERP_PROVIDER=own
DATAFORSEO_LOGIN=
DATAFORSEO_PASSWORD=

# ══════════════════════════════════════════════════════════════════════════
# PRODUCTION MODE (infra/docker-compose.searchos.yml, integrated with the
# existing FreightIt/SureShift stack)
# These values are NOT set here — they come from your real .env at
# ~/SureShiftERP/.env via variable interpolation in the compose file:
#   POSTGRES_USER, POSTGRES_PASSWORD  (already in your .env)
#   REDIS_PASSWORD                    (already in your .env)
#   LM_STUDIO_URL                     (already in your .env)
#   SEARCHOS_JWT_SECRET_KEY           (NEW — add this one, see
#                                       infra/postgres-init-addendum.md)
# See infra/postgres-init-addendum.md for the one DB-provisioning step
# required before first boot.
# ══════════════════════════════════════════════════════════════════════════
